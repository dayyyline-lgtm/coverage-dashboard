# 이 파일을 secrets_local.py 로 이름을 바꾸고 아래 두 값을 채우세요.
# (secrets_local.py 는 .gitignore 로 막혀 있어 GitHub에 올라가지 않습니다)
#
# 봇을 새로 만들 필요 없습니다. 대시보드 알림에 쓰는 그 봇 토큰 그대로 넣으면 됩니다.
#
# 토큰 다시 확인하는 법:
#   텔레그램에서 @BotFather → /mybots → 봇 선택 → API Token
#
# chat_id 확인하는 법 (토큰만 먼저 채운 뒤):
#   봇에게 아무 메시지나 한 번 보내고, 브라우저에서 아래 주소를 엽니다.
#   https://api.telegram.org/bot<토큰>/getUpdates
#   → "chat":{"id":123456789} 의 숫자가 chat_id 입니다.

TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""
